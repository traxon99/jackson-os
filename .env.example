# Node environment (development | production | test)
NODE_ENV=development

# HTTP listen port
PORT=8080

# Public URL of the web app (required)
APP_ORIGIN=

# Trust Cloudflare CF-Connecting-IP for client IP (true | false)
TRUST_CLOUDFLARE=false

# Built SPA assets directory (relative to apps/server by default)
WEB_DIST=../web/dist

# Directory for persistent data
DATA_DIR=/data

# WebAuthn relying party ID
RP_ID=os.jacksonyanek.com

# One-time setup token (min 32 characters); optional
SETUP_TOKEN=

# Jim read-only API base URL (not a secret)
JIM_API_URL=https://jim-mcp.fly.dev

# Jim integration personal access token; optional
JIM_PAT=

# GitHub API token; optional
GITHUB_TOKEN=

# Cloudflare API token for portfolio integration; optional
CLOUDFLARE_API_TOKEN=

# Cloudflare zone ID for portfolio integration; optional
CLOUDFLARE_ZONE_ID=
