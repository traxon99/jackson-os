# Node environment (development | production | test)
NODE_ENV=development

# HTTP listen port
PORT=8080

# Public URL of the web app (required)
APP_ORIGIN=

# Supabase Postgres connection string (required)
# Dedicated jackson-os project (public schema). Session, direct, or pooler URI.
DATABASE_URL=

# Trust Cloudflare CF-Connecting-IP for client IP (true | false)
TRUST_CLOUDFLARE=false

# Built SPA assets directory (relative to apps/server by default)
WEB_DIST=../web/dist

# WebAuthn relying party ID
RP_ID=os.jacksonyanek.com

# One-time setup token (min 32 characters); optional
SETUP_TOKEN=

# Optional bearer for POST /api/cron/tick (min 16 characters). The in-process scheduler does not need it.
CRON_SECRET=

# Optional bearer for Grok Bot / external agent API (min 32 characters). See docs/AGENT-INTEGRATION.md.
AGENT_API_TOKEN=

# Jim read-only API base URL (not a secret)
JIM_API_URL=https://jim-mcp.fly.dev

# Jim integration personal access token; optional
JIM_PAT=

# GitHub API token; optional
GITHUB_TOKEN=

# Cloudflare API token for portfolio integration; optional
CLOUDFLARE_API_TOKEN=

# Cloudflare zone ID for portfolio integration; optional
CLOUDFLARE_ZONE_ID=

# Live cameras; optional. See docs/CAMERAS.md.
# Comma-separated id=Label pairs. Each id must match a MediaMTX path name.
CAMERAS=
# MediaMTX HLS base URL on the private Compose network (not a public URL)
MEDIAMTX_HLS_URL=
# MediaMTX control API base URL, used for live/offline status; optional
MEDIAMTX_API_URL=
