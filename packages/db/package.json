{
  "name": "@jos/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./src/open-test.ts",
      "development": "./src/open-test.ts",
      "import": "./dist/open-test.js",
      "default": "./dist/open-test.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p . --outDir dist --rootDir src",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.41.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.8",
    "@types/node": "^22.14.0",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.8.3"
  }
}
